{
  "name": "harolds-plumbing-vapi-backend",
  "version": "1.0.0",
  "description": "Vapi tool backend for Harold's Plumbing NW inbound voice AI dispatcher",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test test/*.test.js",
    "test:manual": "node scripts/manual-api-test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "vapi",
    "plumbing",
    "dispatcher",
    "express",
    "mongodb"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0"
  },
  "allowScripts": {
    "mongodb-memory-server": true
  }
}
