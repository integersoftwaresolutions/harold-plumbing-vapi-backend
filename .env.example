# Server
# PORT is used locally only. Vercel ignores it and provides its own host/port.
PORT=3000
NODE_ENV=development

# MongoDB — required
# Example local: mongodb://127.0.0.1:27017/harolds-plumbing
# Example Atlas: mongodb+srv://USER:PASSWORD@CLUSTER/harolds-plumbing
MONGODB_URI=

# Optional shared secret for Vapi tool calls.
# Leave empty/unset to disable auth (convenient for local development).
# When set, every /api/* request must include header:
#   X-Vapi-Tool-Secret: <same value>
VAPI_TOOL_SECRET=

# JSON body size limit (optional)
# BODY_SIZE_LIMIT=32kb
